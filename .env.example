# Database
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# AI
GEMINI_API_KEY=

# Email (Resend — https://resend.com)
RESEND_API_KEY=
# Defaults to onboarding@resend.dev (Resend's shared test sender) if unset.
# Switch to your own verified domain once available, e.g. Clinzor <noreply@yourdomain.com>
EMAIL_FROM=
# Where replies go. Defaults to clinzorofficial@gmail.com if unset.
EMAIL_REPLY_TO=

# SMS (TeleSign) — TELESIGN_CUSTOMER_ID is required alongside the API key for
# TeleSign's request signing; get it from your TeleSign account dashboard.
TELESIGN_CUSTOMER_ID=
TELESIGN_API_KEY=

# Auth
JWT_SECRET=
JWT_EXPIRY=7d

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_LOCK_MINUTES=30

# App
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
PORT=5000

# Jitsi as a Service (https://jaas.8x8.vc) — required for calls beyond 5 minutes.
# Leave all three unset to keep using the free meet.jit.si demo server.
# JAAS_PRIVATE_KEY is the full PEM downloaded from the JaaS dashboard; when
# pasting into a single-line env var, escape real newlines as \n.
# Also set NEXT_PUBLIC_JITSI_DOMAIN=8x8.vc once these are configured.
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY=

# Physio-platform sync (separate Supabase project, the AI-based video call
# system) — leave unset to skip mirroring patients there entirely.
PHYSIO_PLATFORM_SUPABASE_URL=
PHYSIO_PLATFORM_SUPABASE_SERVICE_KEY=
